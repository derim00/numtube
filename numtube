#!/usr/bin/env bash
# Starts the NumTube gateway. Creates its small Python environment on first run.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/.venv"
if ! "$VENV/bin/python3" -c 'import numpy, usb.core' >/dev/null 2>&1; then
  echo "Préparation de l'environnement Python..."
  [ -x "$VENV/bin/python3" ] || python3 -m venv "$VENV"
  "$VENV/bin/pip" -q install numpy pyusb
fi
exec "$VENV/bin/python3" "$ROOT/gateway/numtube_gateway.py" "$@"
